# ----------------------------------------------------------------------
# MonitorMyHost - Production Apache / LiteSpeed Configuration
# High-performance, SEO-optimized configuration for static prerendered & SPA site
# ----------------------------------------------------------------------

# Disable Directory Browsing and Multiviews
Options -Indexes -MultiViews

# Ensure index.html is the default directory index
DirectoryIndex index.html

# Disable automatic directory trailing slashes (Rule 4: Canonical URLs use NO trailing slash)
DirectorySlash Off

# Enable Rewrite Engine
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ----------------------------------------------------------------------
  # CRITICAL: Exclude API Subdomain & Backend API Endpoints
  # Ensures api.monitormyhost.com and all backend routes (e.g. /demo/session,
  # /demo/status, /demo/health, /auth/*, /ttfb/*, /socket.io/*, etc.)
  # pass directly through to Node.js without triggering frontend 301 redirects,
  # directory rewrites, or SPA index.html fallbacks.
  # ----------------------------------------------------------------------
  RewriteCond %{HTTP_HOST} ^api\. [NC,OR]
  RewriteCond %{REQUEST_URI} ^/demo/(session|status|health) [NC,OR]
  RewriteCond %{REQUEST_URI} ^/socket\.io [NC]
  RewriteRule ^ - [L]

  # ----------------------------------------------------------------------
  # Canonical Host & HTTPS Redirection
  # Canonical Host: https://monitormyhost.com
  # Strictly for frontend domain
  # ----------------------------------------------------------------------

  # Redirect www.monitormyhost.com -> https://monitormyhost.com (301)
  RewriteCond %{HTTP_HOST} ^www\.monitormyhost\.com$ [NC]
  RewriteRule ^(.*)$ https://monitormyhost.com/$1 [R=301,L]

  # Enforce HTTPS on main domain
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP_HOST} ^(www\.)?monitormyhost\.com$ [NC]
  RewriteRule ^(.*)$ https://monitormyhost.com/$1 [R=301,L]

  # ----------------------------------------------------------------------
  # Trailing Slash Normalization (Rule 4: NO trailing slash)
  # Redirect /ttfb-test/ -> /ttfb-test (301)
  # Excludes root "/" and existing physical files
  # Strictly for frontend GET requests
  # ----------------------------------------------------------------------
  RewriteCond %{HTTP_HOST} ^(www\.)?monitormyhost\.com$ [NC]
  RewriteCond %{REQUEST_METHOD} =GET
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} ^/(.+)/$
  RewriteRule ^(.+)/$ /$1 [R=301,QSA,L]

  # ----------------------------------------------------------------------
  # Backward Compatibility Redirects -> Canonical Slugs (301 with QSA)
  # Strictly for frontend domain on GET requests (never API or OPTIONS/POST)
  # ----------------------------------------------------------------------
  RewriteCond %{HTTP_HOST} ^(www\.)?monitormyhost\.com$ [NC]
  RewriteCond %{REQUEST_METHOD} =GET
  RewriteRule ^demo/?$ /ttfb-test [R=301,QSA,L]

  RewriteCond %{HTTP_HOST} ^(www\.)?monitormyhost\.com$ [NC]
  RewriteCond %{REQUEST_METHOD} =GET
  RewriteRule ^demo/ttfb/?$ /ttfb-test [R=301,QSA,L]

  RewriteCond %{HTTP_HOST} ^(www\.)?monitormyhost\.com$ [NC]
  RewriteCond %{REQUEST_METHOD} =GET
  RewriteRule ^demo/lighthouse/?$ /fullsite-report [R=301,QSA,L]

  RewriteCond %{HTTP_HOST} ^(www\.)?monitormyhost\.com$ [NC]
  RewriteCond %{REQUEST_METHOD} =GET
  RewriteRule ^demo/dns/?$ /dns-checker [R=301,QSA,L]

  RewriteCond %{HTTP_HOST} ^(www\.)?monitormyhost\.com$ [NC]
  RewriteCond %{REQUEST_METHOD} =GET
  RewriteRule ^demo/redirects/?$ /redirection-checker [R=301,QSA,L]

  RewriteCond %{HTTP_HOST} ^(www\.)?monitormyhost\.com$ [NC]
  RewriteCond %{REQUEST_METHOD} =GET
  RewriteRule ^demo/whois/?$ /whois-lookup [R=301,QSA,L]

  RewriteCond %{HTTP_HOST} ^(www\.)?monitormyhost\.com$ [NC]
  RewriteCond %{REQUEST_METHOD} =GET
  RewriteRule ^tools/?$ /ttfb-test [R=301,QSA,L]

  RewriteCond %{HTTP_HOST} ^(www\.)?monitormyhost\.com$ [NC]
  RewriteCond %{REQUEST_METHOD} =GET
  RewriteRule ^tools/ttfb/?$ /ttfb-test [R=301,QSA,L]

  RewriteCond %{HTTP_HOST} ^(www\.)?monitormyhost\.com$ [NC]
  RewriteCond %{REQUEST_METHOD} =GET
  RewriteRule ^tools/lighthouse/?$ /fullsite-report [R=301,QSA,L]

  RewriteCond %{HTTP_HOST} ^(www\.)?monitormyhost\.com$ [NC]
  RewriteCond %{REQUEST_METHOD} =GET
  RewriteRule ^tools/dns/?$ /dns-checker [R=301,QSA,L]

  RewriteCond %{HTTP_HOST} ^(www\.)?monitormyhost\.com$ [NC]
  RewriteCond %{REQUEST_METHOD} =GET
  RewriteRule ^tools/redirects/?$ /redirection-checker [R=301,QSA,L]

  RewriteCond %{HTTP_HOST} ^(www\.)?monitormyhost\.com$ [NC]
  RewriteCond %{REQUEST_METHOD} =GET
  RewriteRule ^tools/whois/?$ /whois-lookup [R=301,QSA,L]

  RewriteCond %{HTTP_HOST} ^(www\.)?monitormyhost\.com$ [NC]
  RewriteCond %{REQUEST_METHOD} =GET
  RewriteRule ^ttfb/?$ /ttfb-test [R=301,QSA,L]

  RewriteCond %{HTTP_HOST} ^(www\.)?monitormyhost\.com$ [NC]
  RewriteCond %{REQUEST_METHOD} =GET
  RewriteRule ^lighthouse/?$ /fullsite-report [R=301,QSA,L]

  RewriteCond %{HTTP_HOST} ^(www\.)?monitormyhost\.com$ [NC]
  RewriteCond %{REQUEST_METHOD} =GET
  RewriteRule ^dns/?$ /dns-checker [R=301,QSA,L]

  RewriteCond %{HTTP_HOST} ^(www\.)?monitormyhost\.com$ [NC]
  RewriteCond %{REQUEST_METHOD} =GET
  RewriteRule ^redirects/?$ /redirection-checker [R=301,QSA,L]

  RewriteCond %{HTTP_HOST} ^(www\.)?monitormyhost\.com$ [NC]
  RewriteCond %{REQUEST_METHOD} =GET
  RewriteRule ^whois/?$ /whois-lookup [R=301,QSA,L]

  # ----------------------------------------------------------------------
  # Static Prerendered Route Resolution
  # Maps clean URL paths to generated /<slug>/index.html internally
  # This prevents mod_dir from issuing 301 trailing-slash redirects on directories,
  # avoiding infinite redirect loops and serving prerendered HTML directly.
  # Excludes api subdomain requests.
  # ----------------------------------------------------------------------

  # Specific canonical prerendered tool and content routes
  RewriteCond %{HTTP_HOST} !^api\. [NC]
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f [OR]
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(ttfb-test|fullsite-report|dns-checker|redirection-checker|whois-lookup|about|contact)/?$ $1/index.html [QSA,L]

  # General rule: if any requested path is a directory containing index.html, serve that index.html directly
  RewriteCond %{HTTP_HOST} !^api\. [NC]
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f [OR]
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^([^/]+)/?$ $1/index.html [QSA,L]

  # Pass existing physical files directly (JS, CSS, images, robots, sitemap, etc.)
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # ----------------------------------------------------------------------
  # SPA Fallback for all other non-file routes
  # Passes routing to React Router so dynamic routes, query params,
  # and client-side redirects (e.g. /login -> app subdomain) work seamlessly.
  # Excludes api subdomain requests.
  # ----------------------------------------------------------------------
  RewriteCond %{HTTP_HOST} !^api\. [NC]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.html [QSA,L]
</IfModule>

# Custom Error Document for 404s
ErrorDocument 404 /404.html

# ----------------------------------------------------------------------
# HTTP Headers & Robots Directives
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
  # webpulse.monitormyhost.com receives noindex via X-Robots-Tag header
  SetEnvIfNoCase Host ^webpulse\. is_app_subdomain
  Header always set X-Robots-Tag "noindex, nofollow, noarchive" env=is_app_subdomain

  # Never cache HTML or data feeds so users/bots receive fresh prerendered content
  <FilesMatch "\.(html|htm|json|xml|txt)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Cache fingerprinted static assets (hashes in filenames) for 1 year
  <FilesMatch "\.(js|css|woff2?|png|jpe?g|gif|svg|ico|webp|avif)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Security Headers
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ----------------------------------------------------------------------
# Gzip / Brotli Compression
# ----------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
