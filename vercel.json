{
  "redirects": [
    {
      "source": "/hosting-reviews/:slug",
      "destination": "/reviews/:slug",
      "permanent": true
    },
    {
      "source": "/hosting-reviews",
      "destination": "/reviews",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

